<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 리랭커(bge-reranker-v2-m3) 상시 실행. Ollama에 rerank API가 없어 llama.cpp llama-server로 띄운다 (PROJECT.md 13.3) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.vesta.reranker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/llama-server</string>
        <string>--rerank</string>
        <string>-m</string>
        <string>__HOME__/.vesta/models/bge-reranker-v2-m3-Q8_0.gguf</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8082</string>
        <string>--ctx-size</string>
        <string>8192</string>
        <string>--ubatch-size</string>
        <string>8192</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.vesta/logs/reranker.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.vesta/logs/reranker.err.log</string>
</dict>
</plist>
